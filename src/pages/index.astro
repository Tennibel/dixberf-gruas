---
import {withBase} from '../utils/paths';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import CTA from '../components/CTA.astro';
import Hero from '../components/Hero.astro';
import {projects} from '../data/site';
const services=[{n:'01',title:'Grúas industriales',text:'La fuerza y el alcance que tu proyecto necesita.',image:'telescopica',slug:'renta-gruas-industriales',tag:'IZAJE DE PRECISIÓN'},{n:'02',title:'Grúa HIAB',text:'Carga, traslada y coloca en un solo servicio.',image:'hiab',slug:'grua-hiab',tag:'VERSATILIDAD EN CAMPO'},{n:'03',title:'Maniobras industriales',text:'Planeamos cada movimiento de tu maquinaria.',image:'maniobra',slug:'maniobras-industriales',tag:'CONTROL EN CADA PASO'},{n:'04',title:'Transporte especializado',text:'Tu carga pesada, de origen a destino.',image:'transporte',slug:'transporte-maquinaria-pesada',tag:'COBERTURA NACIONAL'}];
---
<Base title="Grúas industriales en Toluca y México | DIXBERF" description="Renta de grúas industriales, maniobras y transporte de maquinaria pesada desde Toluca. Atención 24/7 y cobertura nacional. Cotiza tu maniobra con DIXBERF.">
<Hero/>
<div class="facts"><div class="wrap facts-grid"><div><strong>24<span>/</span>7</strong><p>Disponibles para tu proyecto</p></div><div><strong>365</strong><p>Días del año en operación</p></div><div><strong>Todo México</strong><p>Cobertura desde Toluca</p></div><div><strong>Un solo aliado</strong><p>Izaje, maniobra y transporte</p></div></div></div>
<div class="motion-ribbon" aria-hidden="true"><div class="motion-ribbon-track" data-scroll-ribbon><span>PRECISIÓN</span><b>↗</b><span class="outline-word">SEGURIDAD</span><b>↗</b><span>MOVIMIENTO</span><b>↗</b><span class="outline-word">DIXBERF</span><b>↗</b></div></div>
<section id="servicios" class="section"><div class="wrap"><div class="section-head" data-reveal><div><p class="eyebrow">01 / LO QUE HACEMOS</p><h2>Grandes cargas.<br/><span class="muted">Soluciones precisas.</span></h2></div><p>Todo lo que necesitas para mover una carga pesada. El equipo correcto, con las personas que saben operarlo.</p></div><div class="service-grid">{services.map(s=><a class="service-card" href={withBase(`/${s.slug}/`)} data-reveal><div class="card-photo"><Photo name={s.image} alt={`${s.title}: equipo de DIXBERF en operación`} sizes="(max-width: 600px) calc((100vw - 56px) / 2), (max-width: 850px) calc((100vw - 86px) / 2), 25vw"/><span class="card-number">{s.n}</span></div><div class="card-copy"><p class="eyebrow">{s.tag}</p><h3>{s.title}</h3><p>{s.text}</p><span class="card-link">Explorar servicio <span aria-hidden="true">↗</span></span></div></a>)}</div><div class="under-grid"><span>¿Tu maniobra requiere otro tipo de equipo?</span><a href={withBase('/renta-montacargas/')} class="text-link">Conoce nuestros montacargas ↗</a></div></div></section>
<section class="about-section"><div class="wrap about-grid"><div class="about-photo" data-reveal data-parallax-photo><Photo name="equipo" alt="Personal y camión grúa de DIXBERF trabajando dentro de una nave industrial"/><span class="photo-label">LA SEGURIDAD SE PLANEA. LA PRECISIÓN SE EJECUTA.</span></div><div class="about-copy" data-reveal><p class="eyebrow">02 / MÁS QUE UN PROVEEDOR</p><h2>Tu carga.<br/>Nuestro compromiso.</h2><p class="lead">Su socio estratégico en servicios logísticos de alto impacto.</p><p>Nos especializamos en la ejecución segura y precisa de maniobras industriales con grúas certificadas y en el transporte especializado de equipos pesados.</p><p>Nuestra flota incluye grúas industriales de distintas capacidades, plataformas, camas bajas y tortons para mover cualquier tipo de carga.</p><a class="text-link" href={withBase('/nosotros/')}>Conoce DIXBERF <span aria-hidden="true">↗</span></a></div></div></section>
<section class="section process-section"><div class="wrap"><div class="section-head" data-reveal><div><p class="eyebrow">03 / CADA MOVIMIENTO TIENE UN PLAN</p><h2>Así planeamos<br/>tu maniobra.</h2></div><a href={withBase('/contacto/')} class="button dark">Planeemos la tuya <span aria-hidden="true">↗</span></a></div><div class="process-track" aria-hidden="true"><span data-process-progress></span></div><ol class="process-grid">{[{t:'Te escuchamos',d:'Nos cuentas qué necesitas mover, dónde y cuándo.'},{t:'Evaluamos',d:'Evaluamos los riesgos y diseñamos el plan de izaje y la logística del movimiento.'},{t:'Cotizamos',d:'Te enviamos la propuesta con el equipo adecuado.'},{t:'Ejecutamos',d:'Ejecutamos la maniobra con grúas certificadas y personal especializado, cumpliendo la normativa federal.'},{t:'Entregamos',d:'Entregamos la carga posicionada en su lugar.'}].map((p,i)=><li data-reveal><span class="step-number">0{i+1}</span><h3>{p.t}</h3><p>{p.d}</p></li>)}</ol></div></section>
<section class="section projects-section"><div class="wrap"><div class="section-head" data-reveal><div><p class="eyebrow light">04 / EXPERIENCIA REAL EN CAMPO</p><h2>El trabajo habla.</h2></div><a href={withBase('/proyectos/')} class="text-link light">Ver trabajos realizados ↗</a></div><div class="project-grid">{projects.slice(0,3).map(p=><a href={withBase('/proyectos/')} class="project-card" data-reveal data-parallax-photo><Photo name={p.image} alt={p.title+' con equipo de DIXBERF'}/><div><p class="eyebrow light">{p.tag}</p><h3>{p.title} <span aria-hidden="true">↗</span></h3></div></a>)}</div><div class="sectors"><p class="eyebrow light">MOVEMOS LA INDUSTRIA</p><p>Construcción <span> / </span> Energía <span> / </span> Minería <span> / </span> Manufactura <span> / </span> Automotriz <span> / </span> Logística</p></div></div></section>
<section class="clients-section"><div class="wrap"><p class="eyebrow">EMPRESAS QUE HAN CONFIADO EN NOSOTROS</p><div class="client-names" aria-label="Clientes mencionados en el catálogo DIXBERF"><span>Coca-Cola</span><span>BIMBO</span><span>Nestlé</span><span>Unilever</span><span>PEMEX</span><span>Stellantis</span></div></div></section>
<section class="section coverage-section"><div class="wrap coverage-grid"><div data-reveal><p class="eyebrow">05 / CERCA DE TU PRÓXIMO PROYECTO</p><h2>Base en Toluca.<br/><span class="muted">Alcance nacional.</span></h2><p>Atención prioritaria en el centro del país y cobertura en toda la República Mexicana. Equipos y personal disponibles las 24 horas, los 365 días del año.</p><a href={withBase('/cobertura/')} class="text-link">Consulta nuestra cobertura ↗</a></div><a class="coverage-panel" href={withBase('/renta-gruas-industriales-toluca/')}><span class="eyebrow">NUESTRO PUNTO DE PARTIDA</span><strong>TOLUCA<span>↗</span></strong><span>Estado de México / México</span><div class="coverage-lines" aria-hidden="true"></div><span class="coverage-note"><i class="status-dot"></i> De aquí, a donde tu proyecto nos lleve.</span></a></div></section><CTA/>
</Base>
