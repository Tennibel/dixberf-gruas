---
import Base from '../layouts/Base.astro';import PageIntro from '../components/PageIntro.astro';import QuoteForm from '../components/QuoteForm.astro';import {site,whatsapp} from '../data/site';
---
<Base title="Cotiza tu maniobra: contacto 24/7 | DIXBERF" description="Cotiza grúas, maniobras industriales y transporte de carga pesada con DIXBERF. Atención 24/7 desde Toluca. Llama al 722 474 7458 o escríbenos por WhatsApp."><PageIntro title="Cotiza tu maniobra." description="Cuéntanos qué necesitas mover y te contactamos para revisar tu maniobra. Atención las 24 horas, los 365 días del año."/><section class="section"><div class="wrap contact-grid"><aside class="contact-details"><p class="eyebrow">CONTACTO DIRECTO</p><h2>Un gran movimiento<br/>empieza hablando.</h2><p>¿Es urgente? Llámanos para revisar disponibilidad y los detalles de tu proyecto.</p><div class="contact-method"><span class="eyebrow">LLÁMANOS</span><a href={site.phoneHref} data-event="phone_click">722 474 7458 ↗</a><a href="tel:+527223816470" data-event="phone_click">722 381 6470 ↗</a><a href="tel:+525525194278" data-event="phone_click">55 2519 4278 ↗</a></div><div class="contact-method"><span class="eyebrow">WHATSAPP</span><a href={whatsapp()} data-event="whatsapp_click">Revisemos tu maniobra ↗</a></div><div class="contact-method"><span class="eyebrow">ESCRÍBENOS</span><a href={`mailto:${site.email}`} data-event="email_click">{site.email} ↗</a></div><div class="contact-method"><span class="eyebrow">BASE OPERATIVA</span><span>Toluca, Estado de México</span><span>Cobertura nacional · Servicio 24/7</span></div></aside><QuoteForm/></div></section></Base>
