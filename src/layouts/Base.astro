---
import {withBase} from '../utils/paths';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/interiors.css';
import headingFont from '@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url';
import bodyFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import {site,whatsapp} from '../data/site';
interface Props {title:string;description:string;noindex?:boolean;schema?:Record<string,unknown>;industrial?:boolean;}
const {title,description,noindex=false,schema,industrial=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url).href;
const nav=[['Servicios','/#servicios'],['Equipos','/equipos/'],['Proyectos','/proyectos/'],['Nosotros','/nosotros/'],['Cobertura','/cobertura/']];
const business={'@context':'https://schema.org','@type':'LocalBusiness','@id':site.url+'/#business',name:site.name,url:site.url,telephone:'+527224747458',email:site.email,image:site.url+'/images/social.jpg',address:{'@type':'PostalAddress',addressLocality:'Toluca',addressRegion:'Estado de México',addressCountry:'MX'},areaServed:{'@type':'Country',name:'México'},openingHoursSpecification:[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'00:00',closes:'23:59'}],...(site.google?{sameAs:[site.google]}:{})};
---
<!doctype html><html lang="es-MX"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin/><link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin/><meta name="theme-color" content="#191c1c"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={(noindex||import.meta.env.PUBLIC_PREVIEW==='true')?'noindex, follow':'index, follow'}/><link rel="canonical" href={canonical}/><link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml"/><link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')}/><meta property="og:type" content="website"/><meta property="og:locale" content="es_MX"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={site.url+'/images/social.jpg'}/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(business).replace(/</g,'\\u003c')}/>{schema&&<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>}<meta name="ga-id" content={import.meta.env.PUBLIC_GA_ID||''}/></head>
<body class:list={[{'home-page':Astro.url.pathname===withBase('/'), 'industrial-page':industrial}]}><div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div><a class="skip-link" href="#contenido">Saltar al contenido</a>
<div class="utility"><div class="wrap"><span><i class="status-dot"></i> EQUIPOS Y PERSONAL DISPONIBLES 24/7</span><a href={site.phoneHref} data-event="phone_click">TOLUCA, ESTADO DE MÉXICO <span class="utility-phone">&nbsp; / &nbsp; {site.phone} ↗</span></a></div></div>
<header class="header"><div class="wrap nav-wrap"><a href={withBase('/')} class="brand" title="Ir al inicio"><span class="brand-mark" aria-hidden="true">D<span>↗</span></span><span class="brand-type">DIXBERF<small>GRÚAS · MANIOBRAS · TRANSPORTE</small></span></a><button class="menu-toggle" aria-controls="navigation" aria-expanded="false" aria-label="Abrir menú"><span></span><span></span></button><nav id="navigation" aria-label="Navegación principal">{nav.map(([label,href])=><a href={withBase(href)} aria-current={Astro.url.pathname===withBase(href)?'page':undefined}>{label}</a>)}<a href={withBase('/contacto/')} class="button small">Cotizar maniobra <span aria-hidden="true">↗</span></a></nav></div></header>
<main id="contenido"><slot/></main>
<footer class="footer"><div class="wrap"><div class="footer-top"><a href={withBase('/')} class="brand" title="Ir al inicio"><span class="brand-mark" aria-hidden="true">D<span>↗</span></span><span class="brand-type">DIXBERF<small>GRÚAS · MANIOBRAS · TRANSPORTE</small></span></a><p>Elevando tus proyectos,<br/>asegurando tu éxito.</p></div><div class="footer-grid"><div><p class="eyebrow">HABLEMOS DE TU MANIOBRA</p><a class="footer-phone" href={site.phoneHref} data-event="phone_click">{site.phone} ↗</a><a href="tel:+527223816470" data-event="phone_click">722 381 6470</a><a href="tel:+525525194278" data-event="phone_click">55 2519 4278</a><a href={`mailto:${site.email}`} data-event="email_click">{site.email}</a></div><div><p class="eyebrow">SERVICIOS</p><a href={withBase('/renta-gruas-industriales/')}>Grúas industriales</a><a href={withBase('/gruas-telescopicas/')}>Grúas telescópicas</a><a href={withBase('/grua-hiab/')}>Grúa HIAB</a><a href={withBase('/maniobras-industriales/')}>Maniobras industriales</a><a href={withBase('/transporte-maquinaria-pesada/')}>Transporte especializado</a><a href={withBase('/renta-montacargas/')}>Montacargas</a></div><div><p class="eyebrow">DIXBERF</p><a href={withBase('/equipos/')}>Nuestra flota</a><a href={withBase('/proyectos/')}>Trabajos realizados</a><a href={withBase('/nosotros/')}>Nosotros</a><a href={withBase('/cobertura/')}>Cobertura nacional</a><a href={withBase('/renta-gruas-industriales-toluca/')}>Grúas en Toluca</a>{site.google&&<a href={site.google} rel="noopener noreferrer" target="_blank">Ver ficha en Google ↗</a>}</div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} DIXBERF.</span><div><a href={withBase('/aviso-legal/')}>Aviso legal</a><a href={withBase('/politica-de-privacidad/')}>Privacidad</a><a href={withBase('/aviso-de-cookies/')}>Cookies</a><button type="button" id="cookie-settings">Preferencias de cookies</button></div></div></div></footer>
<a class="floating-whatsapp" href={whatsapp()} data-event="whatsapp_click" aria-label="Cotiza por WhatsApp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 11.6a8 8 0 0 1-11.8 7L4 20l1.3-4.3A8 8 0 1 1 20 11.6Z"/><path d="M8.5 7.6c-.8 2.8 2.7 6.9 5.9 7.3l1.2-1.7-2.1-1.2-.9.8c-1.4-.7-2.1-1.5-2.6-2.6l.7-.9-1-1.8Z"/></svg><span>Cotiza por WhatsApp</span><span aria-hidden="true">↗</span></a>
<section class="cookie-banner" id="cookie-banner" aria-labelledby="cookie-title" hidden><strong id="cookie-title">Tu privacidad también importa.</strong><p>Usamos almacenamiento necesario para recordar tu elección. Sólo activamos analítica si la aceptas. <a href={withBase('/aviso-de-cookies/')}>Ver aviso de cookies</a>.</p><div><button type="button" data-consent="denied">Sólo necesarias</button><button type="button" data-consent="granted">Aceptar analítica</button></div></section>
<script src="../scripts/client.ts"></script>
</body></html>
